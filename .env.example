# Exemplo de variaveis de ambiente para o TimescaleDB (Docker)
# Copie para ".env" e ajuste se necessario. O ".env" NAO vai para o git.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inmet

# Conexao a partir do codigo Python (fora do container)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Ingestao
PASTA_ENTRADA=C:\Users\moral\Downloads\meteorologia
BATCH_SIZE=50000
CHUNK_SIZE=100000

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inmet